; Dragon Heroes — Godot 4.6+ project (presentation only, canon §10 rule 2:
; zero gameplay rules live here; the client renders replicated sim state).
; Current flow is the M1 prototype slice (game/prototype/) — a clearly marked
; placeholder until dh-sim arrives via GDExtension. Menu flow: Main Menu (offline
; login) -> Haven (game menu) -> Hunt (prototype/main.tscn); the Session autoload
; carries character state across scenes.
; Renderer note: prototype uses gl_compatibility for maximum desktop robustness;
; the shipping mobile-renderer decision lives in docs/design/17.

config_version=5

[application]

config/name="Dragon Heroes — Codex"
config/icon="res://branding/dragon-heroes.png"
config/windows_native_icon="res://branding/dragon-heroes.ico"
config/use_custom_user_dir=true
config/custom_user_dir_name="Dragon Heroes Codex"
config/description="Fast-paced dark-fantasy pixel-art ARPG. This client is a thin presentation layer over the dh-sim GDExtension."
run/main_scene="res://prototype/ui/main_menu.tscn"
; The "trainer" export boots straight into the arena: a RELEASE template
; refuses a scene path on the command line (disable_path_overrides), and a
; release build is the whole point — it drops GDScript's debug checks.
run/main_scene.trainer="res://arena/arena.tscn"
; The "console" export is the training cockpit as its own application —
; the icon-bearing binary tools/install_arena_launcher.py puts in the
; desktop menu, so the arena is something you click, not something you
; remember a godot command line for.
run/main_scene.console="res://arena/console.tscn"
; ...and the content pipeline is the same idea: an application, not a
; scene path you have to remember (Ricardo tried to run the .tscn from
; bash and got 'Permissão negada' — a .tscn is data, not a program).
run/main_scene.genforge="res://genforge/console.tscn"
; Godot flushes stdout per print in DEBUG builds but not in release ones,
; so a release trainer's "ARENA SERVE READY" sat in the C buffer and the
; worker pool timed out waiting for a line the engine had already written.
; The arena prints ~2 lines per match, so the flush costs nothing.
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.6")

[autoload]

LairJourney="*res://living/journey.gd"

LairJourneyProbe="*res://living/journey_probe.gd"

CodexPackageProbe="*res://tools/package_smoke.gd"

Session="*res://prototype/ui/session.gd"
MpNet="*res://mp/mp_net.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[shader_globals]

; The ONE light registry (canon §12.30): darkness.gd packs the active light
; holes into a 16x2 RGBAF data texture each frame (row 0: xy,radius,strength;
; row 1: rgb,casts_shadows). Darkness, fog, and the sprite N.L shaders all
; read the same texture — one gather, many consumers.
dh_light_tex={
"type": "sampler2D",
"value": ""
}
dh_light_count={
"type": "int",
"value": 0
}
