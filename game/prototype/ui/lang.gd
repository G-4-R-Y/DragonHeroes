# PROTOTYPE HARNESS — chrome localization (EN / PT-BR). Static-only API, no
# autoload: ProtoLang.t("key") for fixed chrome strings, ProtoLang.pick(dict,
# "field") for data-driven text (skill_trees.json carries name_pt/desc_pt/
# synergy_pt next to the EN fields). The language persists in
# user://settings.json and defaults to "en" (tests run in English). Proper
# nouns — item names, creature names, class names like Veilblade — stay
# untranslated by design; only the words AROUND them localize. The shipping
# localization pipeline is a real .po/CSV pass through dh-content later.
class_name ProtoLang
extends RefCounted

const SETTINGS_PATH := "user://settings.json"

static var lang := "en"
static var _loaded := false

