# Fixed chrome string for the current language. Missing keys fall back to the
# key's EN entry, then to the key itself — never crashes on a typo.
static func t(key: String) -> String:
	_ensure()
	var e: Dictionary = S.get(key, {})
	if e.is_empty():
		return key
	return str(e.get(lang, e.get("en", key)))

# Data-driven text: "<field>_pt" wins when the language is pt and the field
# exists; otherwise the EN field (skill_trees.json nodes/branches/statuses).
static func pick(d: Dictionary, field: String, default := "") -> String:
	_ensure()
	if lang == "pt" and d.has(field + "_pt"):
		return str(d[field + "_pt"])
	return str(d.get(field, default))

# Registry-word lookup ("rarity"+"rare" -> t("rarity_rare")); unknown words
# pass through untouched so data never renders as a bare key.
static func term(prefix: String, word: String) -> String:
	var key := prefix + "_" + word
	if S.has(key):
		return t(key)
	return word

static func set_lang(l: String) -> void:
	_ensure()
	lang = "pt" if l == "pt" else "en"
	# MERGE into the shared settings file — display (ProtoDisplay) and audio
	# (ProtoAudio) keys live here too; this used to rewrite it as {"lang"} alone
	# and silently wiped them on every language toggle
	var root := {}
	var raw := FileAccess.get_file_as_string(SETTINGS_PATH)
	if not raw.is_empty():
		var parsed: Variant = JSON.parse_string(raw)
		if parsed is Dictionary:
			root = parsed
	root["lang"] = lang
	var f := FileAccess.open(SETTINGS_PATH, FileAccess.WRITE)
	if f != null:
		f.store_string(JSON.stringify(root, "\t"))

# Lazy load on first access; a missing/corrupt settings file just keeps "en".
static func _ensure() -> void:
	if _loaded:
		return
	_loaded = true
	var raw := FileAccess.get_file_as_string(SETTINGS_PATH)
	if raw.is_empty():
		return
	var parsed: Variant = JSON.parse_string(raw)
	if parsed is Dictionary and str((parsed as Dictionary).get("lang", "")) in ["en", "pt"]:
		lang = str((parsed as Dictionary)["lang"])
