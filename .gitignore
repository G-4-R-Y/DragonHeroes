# C++ / CMake
sim/build/
sim/build-godot*/
# godot-cpp is vendored by tools/vendor_godot_cpp.sh, pinned to a tag
sim/libs/dh-godot/third_party/
# built by tools/build_dh_godot.sh; the arena falls back to GDScript without it
game/addons/dh_godot/*.so
sim/build-windows/
# Pre-merge leftovers (R77, 2026-09-22). The Windows cross-build consolidated
# into sim/build-windows/ and the codex flavour's output into builds/. These
# two stay ignored so a tree that still has the old directories on disk never
# offers them up; nothing writes to them any more and both are safe to delete.
sim/build-codex-windows/
builds/codex/
*.o
*.a

# Godot
game/.godot/
game/export/
*.import

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Go
backend/economy-core/economy-core

# ML artifacts
ml/**/runs/
ml/**/checkpoints/
*.onnx
ml/data/episodes/
ml/serving/weights/

# GenForge candidates — generated bundles are quarantined output, never
# committed (candidate contract, docs/tech/28 §6). Keep the directory.
genforge/candidates/*
!genforge/candidates/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store

# Secrets — never commit credentials
.env
*.secret.*
.env.local
ml/data/progress/
ml/data/logs/
ml/data/benchmarks/
ml/data/ppo_snapshots/
ml/.venv/

# raw export dirs (100 MB GitHub limit) — the zips are the distributable
builds/linux/
builds/windows/
# tools/build_arena.sh — a 96 MB release export
builds/trainer/
# the Arena Console app (tools/build_console.sh) — binary + its GDExtension
builds/console/
rebirth/native/build/
rebirth/godot3d/.godot/
