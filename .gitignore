.vscode/
.idea/
.DS_Store

# Secrets — never commit credentials
.env
*.secret.*
.env.local
rebirth/
ml/data/progress/
ml/data/logs/
ml/.venv/

# raw export dirs (100 MB GitHub limit) — the zips are the distributable
builds/linux/
builds/windows/
