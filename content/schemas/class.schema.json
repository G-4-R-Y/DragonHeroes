{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Class definition",
  "description": "A class ships as pure data (canon §3, docs/design/10): fantasy + resource + skill tree over the shared attribute web and base rig.",
  "type": "object",
  "required": ["id", "name", "role", "resource", "skill_tree"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+\\.class\\.[a-z0-9_]+$" },
    "name": { "type": "string" },
    "role": { "type": "string" },
    "resource": {
      "type": "object",
      "required": ["name", "max", "regen_per_s"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "regen_per_s": { "type": "number" }
      }
    },
    "skill_tree": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node", "kind"],
        "additionalProperties": false,
        "properties": {
          "node": { "type": "string", "description": "Node id, unique within the tree" },
          "kind": { "enum": ["active", "passive", "modifier", "keystone"] },
          "grants_skill": { "type": "string", "pattern": "^[a-z0-9_]+\\.skill\\.[a-z0-9_]+$" },
          "modifies": { "type": "string", "description": "For kind=modifier: the node id it modifies" },
          "requires": { "type": "array", "items": { "type": "string" } },
          "stat_mods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stat", "value"],
              "additionalProperties": false,
              "properties": {
                "stat": { "type": "string" },
                "value": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
