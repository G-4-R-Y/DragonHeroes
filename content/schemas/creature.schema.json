{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Creature definition",
  "description": "A creature is data: archetype rig + palette/parts + stat block + skill set + AI profile (canon §4). Boss canon: elite tier requires >=5 skills forming a coherent strategy; legendary allows up to 10 and may declare duo partners (validated by tools/validate_content.py).",
  "type": "object",
  "required": ["id", "name", "archetype", "family", "tier", "rarity", "stats", "skills", "ai_profile", "loot_table"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+\\.creature\\.[a-z0-9_]+$" },
    "name": { "type": "string", "minLength": 1 },
    "archetype": {
      "enum": ["quadruped", "humanoid", "winged_beast", "avian", "dragon", "giant", "serpent", "spirit", "arachnid", "amorphous"]
    },
    "family": { "type": "string", "description": "Lore group whose skill pool pets draw from, e.g. 'abyssal' (canon glossary)" },
    "tier": { "enum": ["normal", "elite", "legendary"] },
    "rarity": { "enum": ["common", "uncommon", "rare", "epic", "legendary"] },
    "palette": { "type": "string", "description": "Palette-LUT id applied to the archetype rig" },
    "stats": {
      "type": "object",
      "required": ["hp", "damage", "move_speed", "radius"],
      "additionalProperties": { "type": "number" },
      "properties": {
        "hp": { "type": "number", "exclusiveMinimum": 0 },
        "damage": { "type": "number", "minimum": 0 },
        "move_speed": { "type": "number", "exclusiveMinimum": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0, "description": "Hitbox circle radius in meters" }
      }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+\\.skill\\.[a-z0-9_]+$" },
      "maxItems": 10,
      "description": "Signature skills. Validator enforces tier minimums (elite >=5)."
    },
    "ai_profile": { "type": "string", "pattern": "^[a-z0-9_]+\\.ai\\.[a-z0-9_]+$" },
    "loot_table": { "type": "string", "pattern": "^[a-z0-9_]+\\.loot\\.[a-z0-9_]+$" },
    "duo_partners": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+\\.creature\\.[a-z0-9_]+$" },
      "description": "Legendary duo hunting: creatures this one may spawn alongside, with field-combo synergies (canon §4)"
    },
    "capturable": { "type": "boolean", "default": false, "description": "Can be captured as a Pet (rolls skills from its family pool)" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
