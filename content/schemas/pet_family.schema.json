{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pet family definition",
  "description": "Canon §3 (v0.2): a captured pet rolls random attributes + a random skill set from its family pool — sparse lore-coherent family-shared skills plus species-signature skills. Perfect-roll pets are top marketplace chase assets.",
  "type": "object",
  "required": ["id", "name", "lore", "family_shared_skills", "species"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+\\.pet_family\\.[a-z0-9_]+$" },
    "name": { "type": "string" },
    "lore": { "type": "string", "description": "The story that makes skill sharing coherent (e.g. creatures of the Abyss)" },
    "family_shared_skills": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+\\.skill\\.[a-z0-9_]+$" },
      "description": "Kept sparse deliberately — rarity of sharing preserves permutation novelty (canon §3)"
    },
    "species": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["creature", "signature_skills"],
        "additionalProperties": false,
        "properties": {
          "creature": { "type": "string", "pattern": "^[a-z0-9_]+\\.creature\\.[a-z0-9_]+$" },
          "signature_skills": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9_]+\\.skill\\.[a-z0-9_]+$" }
          }
        }
      }
    },
    "roll_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill_slots": { "type": "integer", "minimum": 1, "maximum": 4, "default": 3 },
        "family_skill_chance": { "type": "number", "minimum": 0, "maximum": 1, "description": "Per-slot chance a roll comes from the family pool instead of species signatures" },
        "attribute_roll_range": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_pct": { "type": "number" },
            "max_pct": { "type": "number" }
          }
        }
      }
    }
  }
}
