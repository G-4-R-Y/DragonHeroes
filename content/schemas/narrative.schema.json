{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "dependencies",
    "archetypes",
    "threads",
    "factions",
    "events",
    "links"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 12,
      "maxLength": 3000
    },
    "dependencies": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^genforge/releases/[a-z0-9_]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "identity",
          "lore",
          "creatures"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "identity": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "lore": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "creatures": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "threads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "premise",
          "members",
          "open_question"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "premise": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
            }
          },
          "open_question": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          }
        }
      }
    },
    "factions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "principle",
          "stake",
          "lore"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "principle": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "stake": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "lore": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "lore",
          "factions",
          "outcomes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "lore": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "factions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
            }
          },
          "outcomes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "consequence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 12,
                  "maxLength": 3000
                },
                "consequence": {
                  "type": "string",
                  "minLength": 12,
                  "maxLength": 3000
                }
              }
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "relationship",
          "meaning"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "relationship": {
            "enum": [
              "continues",
              "consequence",
              "disputes",
              "inherits",
              "reveals"
            ]
          },
          "meaning": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Connected weekly narrative candidate; story outcomes are not executable commands"
}
