{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "release", "creature", "hunter_hp", "boss_hp", "move_speed", "base_damage", "affix_damage_per_point", "phases"],
  "properties": {
    "version": {"const": 1},
    "release": {"type": "string", "pattern": "^genforge/releases/[a-z0-9_]+\\.json$"},
    "creature": {"type": "string"},
    "hunter_hp": {"type": "number", "minimum": 50, "maximum": 1000},
    "boss_hp": {"type": "number", "minimum": 100, "maximum": 10000},
    "move_speed": {"type": "number", "minimum": 50, "maximum": 200},
    "base_damage": {"type": "number", "minimum": 1, "maximum": 100},
    "affix_damage_per_point": {"type": "number", "minimum": 0, "maximum": 1},
    "phases": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["skill", "verb", "windup", "recovery", "damage", "radius"],
      "properties": {
        "skill": {"type": "string"},
        "verb": {"enum": ["pools", "storm", "leap", "sweep", "ward"]},
        "windup": {"type": "integer", "minimum": 12, "maximum": 150},
        "recovery": {"type": "integer", "minimum": 15, "maximum": 300},
        "damage": {"type": "number", "minimum": 1, "maximum": 50},
        "radius": {"type": "number", "minimum": 16, "maximum": 100}
      }
    }}
  }
}
