{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "release",
    "hunter_hp",
    "move_speed",
    "base_damage",
    "affix_damage_per_point",
    "lairs",
    "rush"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "release": {
      "type": "string",
      "pattern": "^genforge/releases/[a-z0-9_]+\\.json$"
    },
    "hunter_hp": {
      "type": "number",
      "minimum": 50,
      "maximum": 1000
    },
    "move_speed": {
      "type": "number",
      "minimum": 50,
      "maximum": 200
    },
    "base_damage": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "affix_damage_per_point": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "creature",
          "boss_hp",
          "phases",
          "id",
          "name",
          "placement_salt",
          "region_chunks",
          "reward_cycle"
        ],
        "properties": {
          "creature": {
            "type": "string"
          },
          "boss_hp": {
            "type": "number",
            "minimum": 100,
            "maximum": 10000
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skill",
                "verb",
                "windup",
                "recovery",
                "damage",
                "radius"
              ],
              "properties": {
                "skill": {
                  "type": "string"
                },
                "verb": {
                  "enum": [
                    "pools",
                    "storm",
                    "leap",
                    "sweep",
                    "ward"
                  ]
                },
                "windup": {
                  "type": "integer",
                  "minimum": 12,
                  "maximum": 150
                },
                "recovery": {
                  "type": "integer",
                  "minimum": 15,
                  "maximum": 300
                },
                "damage": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 50
                },
                "radius": {
                  "type": "number",
                  "minimum": 16,
                  "maximum": 100
                }
              }
            }
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.lair\\.[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "placement_salt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "region_chunks": {
            "type": "integer",
            "minimum": 2,
            "maximum": 8
          },
          "reward_cycle": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "rush": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp_step",
        "hp_cap",
        "rest_heal_fraction"
      ],
      "properties": {
        "hp_step": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        },
        "hp_cap": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "rest_heal_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
